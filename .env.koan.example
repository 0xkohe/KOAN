# Run `pnpm run setup` to generate .env.koan with paths for your machine.
# Use absolute paths, without quotes, ~, or shell variable expansion.
# Separate multiple allowed roots with : on Linux/macOS.
KOAN_DATA_DIR=/absolute/path/to/KOAN/.koan
KOAN_ALLOWED_ROOTS=/absolute/path/to/your/projects

# Optional: normally detected from Tailscale Serve.
# KOAN_PUBLIC_URL=https://your-machine.your-tailnet.ts.net/
# KOAN_PORT=18787
# KOAN_DEFAULT_PROJECT_PATH=/absolute/path/to/your/projects

# Local development only. `pnpm dev` sets this automatically.
# KOAN_INSECURE_COOKIE=1
