{
  "name": "@koan/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "KOAN_INSECURE_COOKIE=1 deno run --env-file=../../.env.koan --watch --allow-net=127.0.0.1:18787 --allow-read --allow-write --allow-run --allow-env --allow-sys=homedir,cpus,networkInterfaces src/main.ts",
    "check": "deno check src/main.ts",
    "lint": "deno lint src tests",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-sys=homedir tests"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "qrcode-terminal": "^0.12.0"
  },
  "license": "MIT"
}
